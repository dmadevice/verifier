# verifier configuration. Relative paths are relative to this file, which also marks the project root
# (source paths in the report are given from here).

# annotation tag: `// FUNCTION: GAME 0x140012340`
module = GAME

# the original binary, and optionally its SHA-256 (checked whenever the original is read; a run from the cache
# directory's snapshot relies on the check made when the snapshot was written)
original = orig/game.exe
# original_sha256 = 0123456789abcdef...

# disassembler exports (JSON Lines, the objects the README's Inputs describe); only `functions` is required
functions = analysis/functions.jsonl
vtables = analysis/vtables.jsonl
data_items = analysis/data.jsonl
data_names = analysis/names.jsonl

# library attribution (optional)
# library_matches = analysis/libmatch.json
# library_functions = analysis/library_functions.json

# extra `<decorated name> 0x<va>` lines (optional)
# symbols = analysis/symbols.txt

# where caches are kept (optional): what was read from the map's names (written by a run that had to demangle many
# of them, and by --update), a snapshot of the original (rewritten whenever it or one of its exports changes), the original's
# functions as decoded, and each source file's annotations
cache_dir = .verifier
